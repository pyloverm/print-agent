{
  "name": "qomanda-print-agent",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "tauri dev": "tauri dev",
    "tauri build": "tauri build",
    "agent:start": "node agent.cjs",
    "agent:build:win7": "npm run agent:build:win7:x64 && npm run agent:build:win7:x86",
    "agent:build:win7:x64": "pkg agent.cjs --targets node12-win-x64 --output dist-legacy-agent/qomanda-print-agent-win7-x64.exe",
    "agent:build:win7:x86": "nexe agent.cjs --target windows-x86-12.18.2 --output dist-legacy-agent/qomanda-print-agent-win7-x86.exe"
  },
  "pkg": {
    "assets": ["config.example.json"]
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "lucide-react": "^0.294.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "5",
    "nexe": "4.0.0-rc.6",
    "pkg": "5.8.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
